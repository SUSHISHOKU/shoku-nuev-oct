{
  "firestore": {
    "rules": "firestore.rules"
  },
  "storage": {
    "rules": "storage.rules"
  },
  "hosting": {
    "public": ".",
    "ignore": [
      "firebase.json",
      "*.rules",
      "*.md",
      "**/.*",
      "**/node_modules/**",
      "_respaldo_anterior/**",
      "functions/**",
      "wallet-server/**",
      "secretos/**",
      "public/**",
      "functions-ai/**"
    ],
    "headers": [
      {
        "source": "**/*.@(webp|png|jpg|mp4)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=604800"
          }
        ]
      },
      {
        "source": "admin.html",
        "headers": [
          {
            "key": "X-Robots-Tag",
            "value": "noindex, nofollow"
          }
        ]
      }
    ]
  },
  "functions": [
    {
      "source": "functions",
      "runtime": "nodejs22",
      "ignore": [
        "node_modules",
        ".secret.local",
        "*.log"
      ],
      "predeploy": [
        "node \"$RESOURCE_DIR/sync-shared.cjs\""
      ],
      "codebase": "default"
    },
    {
      "source": "functions-ai",
      "codebase": "ai",
      "runtime": "nodejs22",
      "ignore": [
        "node_modules",
        ".secret.local",
        "*.log"
      ]
    }
  ]
}
